doctype html
html
  head
    title = content_for?(:title) ? "#{yield(:title)} — Bluethumb Art Nano" : "Bluethumb Art Nano"
    meta name="viewport" content="width=device-width,initial-scale=1"
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    = javascript_importmap_tags
  body.bg-stone-50.text-stone-900.flex.flex-col.min-h-screen
    a.skip-link href="#main" Skip to content
    header.bg-white.border-b.border-stone-200.sticky.top-0.z-20.shadow-sm
      .max-w-7xl.mx-auto.px-4.py-3
        .flex.items-center.justify-between.gap-4
          = link_to root_path, class: "text-lg font-semibold tracking-tight shrink-0 text-stone-900 hover:text-accent transition-colors" do
            | Bluethumb Art Nano
          nav.hidden.md:flex.items-center.gap-6.text-sm
            = link_to "Browse", artworks_path, class: nav_link_class(artworks_path)
            = link_to "Style quiz", discover_path, class: nav_link_class(discover_path)
            = link_to "Match my room", match_room_path, class: nav_link_class(match_room_path)
          = form_with url: artworks_path, method: :get, class: "flex-1 max-w-md hidden sm:block" do
            label.sr-only for="header-search" Search artworks
            input#header-search.input-field type="search" name="q" placeholder="Search artworks…" value=params[:q] aria-label="Search artworks"
          .flex.items-center.gap-3.shrink-0
            details.md:hidden.relative
              summary.list-none.cursor-pointer.p-2.rounded-lg.hover:bg-stone-100 aria-label="Open menu"
                svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6" aria-hidden="true"
                  path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
              .absolute.right-0.mt-2.w-48.bg-white.rounded-lg.border.border-stone-200.shadow-lg.py-2.z-30
                = link_to "Browse", artworks_path, class: "block px-4 py-2 text-sm text-stone-700 hover:bg-stone-50"
                = link_to "Style quiz", discover_path, class: "block px-4 py-2 text-sm text-stone-700 hover:bg-stone-50"
                = link_to "Match my room", match_room_path, class: "block px-4 py-2 text-sm text-stone-700 hover:bg-stone-50"
                = link_to "Sign in", login_path, class: "block px-4 py-2 text-sm text-stone-700 hover:bg-stone-50"
            = link_to "Sign in", login_path, class: "text-sm text-stone-600 hover:text-stone-900 hidden sm:inline"
            = link_to cart_path, class: "relative inline-flex items-center gap-1.5 text-sm text-stone-700 hover:text-stone-900" do
              svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5" aria-hidden="true"
                path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"
              = turbo_frame_tag "cart_count" do
                = render "shared/cart_count", cart: current_cart
    main#main.flex-1.max-w-7xl.mx-auto.px-4.py-8.w-full
      = render "shared/flash"
      = yield
    = render "shared/footer"
